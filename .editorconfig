# @file        .editorconfig
# @author      jambaa
# @created     2026-11-18
# @description Shared editor settings so contributions keep a consistent format.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
