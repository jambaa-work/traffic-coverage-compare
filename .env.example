# @file        .env.example
# @author      jambaa
# @created     2026-11-18
# @description Template for local configuration. Copy it and fill in the values:
#                cp .env.example .env.local
#              .env.local is git-ignored. Never commit real keys.
#              Every key is optional; a pane without its key shows a notice instead.
#              VITE_* values are embedded in the browser bundle, so use only
#              browser-restricted public keys here (see docs/api-keys.md).
#              Verify with: npm run check-keys

# City to open by default (an id from src/config/cities.json). ?city=<id> in the URL overrides it.
VITE_DEFAULT_CITY=ulaanbaatar

# Google Maps JavaScript API. HTTP referrer restriction: http://localhost:5190/*
VITE_GOOGLE_MAPS_KEY=

# TomTom (MyTomTom). Domain whitelist: localhost
VITE_TOMTOM_KEY=

# HERE (Access Manager → Apps → API Keys)
VITE_HERE_KEY=

# Mapbox public token (pk.…). URL restriction: http://localhost:5190
VITE_MAPBOX_TOKEN=

# Your own traffic feed: URL of a GeoJSON FeatureCollection of LineStrings with a
# `congestion` property (low | moderate | heavy | severe). Must allow CORS from localhost:5190.
# Try the bundled example: /samples/custom-feed-example.geojson
VITE_CUSTOM_TRAFFIC_URL=

# Optional: when you created the keys (ISO date-time). check-keys reminds you to revoke them after 24 h.
KEYS_CREATED_AT=
